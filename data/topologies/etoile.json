  "scenarios": [
    {
      "id": "deuxieme-envoi",
      "nom": "Deuxième envoi : PC-A écrit encore à PC-B",
      "description": "PC-A envoie deux paquets de suite à PC-B. Au deuxième, la table ARP de PC-A et la table MAC du switch sont déjà remplies : plus de requête ARP, plus d'inondation.",
